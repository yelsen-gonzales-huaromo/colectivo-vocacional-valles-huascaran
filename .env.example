# Supabase Configuration (Opcional pero recomendado para guardar tests de alumnos)
# Obtén estos valores en tu panel de Supabase: Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# GEMINI_API_KEY: Opcional si se usan funciones avanzadas de IA
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base de la aplicación en Vercel o local
APP_URL="http://localhost:3000"
